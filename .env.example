# DeepSeek：主对话使用 Pro，后台整理使用 Flash；API Key 只写本机 .env.local
ROBOT_CHAT_API_KEY=
ROBOT_CHAT_BASE_URL=https://api.deepseek.com
ROBOT_CHAT_MODEL=deepseek-v4-pro
ROBOT_BACKGROUND_MODEL=deepseek-v4-flash
ROBOT_CHAT_PROVIDER=deepseek

# Kimi Code Plan（仅兼容回退，不再默认承担陪伴聊天）
KIMI_CODE_API_KEY=
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODE_MODEL=kimi-for-coding

# 可选的 OpenAI 备用配置（最后回退）
OPENAI_API_KEY=
OPENAI_MODEL=

# 单次模型请求超时，单位毫秒
ROBOT_MODEL_TIMEOUT_MS=45000

# 聊天上下文最近消息的 token 预算
ROBOT_CONTEXT_TOKEN_BUDGET=2400

# 夜间记忆整理（本机时间，每日 23:30）
ROBOT_MEMORY_MAINTENANCE_HOUR=23
ROBOT_MEMORY_MAINTENANCE_MINUTE=30
ROBOT_MAINTENANCE_TIMEOUT_MS=120000

# Mem0 本地长期记忆
ROBOT_MEMORY_ENABLED=true
ROBOT_MEMORY_USER_ID=guanqi
ROBOT_MEMORY_AGENT_ID=home-robot
ROBOT_MEMORY_DB_PATH=D:/robot/data/memory/robot-memory.db
ROBOT_STATE_DB_PATH=D:/robot/data/state/robot-state.db
ROBOT_MEM0_HISTORY_DB_PATH=D:/robot/data/memory/mem0-history.db
ROBOT_OLLAMA_URL=http://127.0.0.1:11434
ROBOT_MEMORY_EMBED_MODEL=nomic-embed-text-v2-moe
ROBOT_QDRANT_HOST=127.0.0.1
ROBOT_QDRANT_PORT=6333
ROBOT_QDRANT_COLLECTION=home_robot_memories

# Supabase 会话保存；项目中需启用 Anonymous Sign-Ins
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 后续备份加密使用，禁止提交真实密钥
ROBOT_BACKUP_KEY=
